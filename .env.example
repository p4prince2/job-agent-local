# =========================================================
# Prince AI Team - Configuration
# =========================================================

# LLM Provider: 'ollama' (default, 100% free/local), 'gemini', or 'openai'
LLM_PROVIDER=ollama

# Ollama Settings (Local AI)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Optional API Keys (Only if you switch LLM_PROVIDER to gemini or openai)
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# GitHub Settings
GITHUB_USERNAME=p4prince2
GITHUB_TOKEN=

# Persistent Storage
DATABASE_PATH=data/prince_ai.db

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
