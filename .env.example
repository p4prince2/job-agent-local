# =========================================================
# Prince AI Team - Environment Configuration (SPEC.md v2)
# =========================================================

# Database Configuration (SQLite + SQLAlchemy)
DATABASE_URL=sqlite:///./data/prince_ai_team.db

# LLM Provider: 'ollama' (default, free/local) or 'anthropic'
LLM_PROVIDER=ollama

# Ollama Settings (Local AI)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Optional Fallback (Anthropic API)
ANTHROPIC_API_KEY=

# GitHub Settings
GITHUB_USERNAME=p4prince2
GITHUB_TOKEN=

# Logging Settings
LOG_LEVEL=INFO
LOG_DIR=data/logs
